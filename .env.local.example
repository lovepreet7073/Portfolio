# Copy this file to .env.local and fill in your values.
#
# Formspree form ID — required for the contact form to actually deliver email.
# Setup:
#   1. Sign up at https://formspree.io (free tier: 50 submissions/month)
#   2. Create a new form, set the "send to" email to lovepreetkaur7073@gmail.com
#   3. Formspree gives you a URL like https://formspree.io/f/xanblogp
#   4. Paste the ID part (e.g. xanblogp) below
#   5. Restart `npm run dev`
NEXT_PUBLIC_FORMSPREE_ID=
